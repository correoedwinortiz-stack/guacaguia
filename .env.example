# ============================================================
#  🦜 Las Guacamayas Sabias — Variables de Entorno
#  Copia este archivo a .env y rellena tus valores
# ============================================================

# ── API Keys de IA (con una basta) ──────────────────────────
# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu_clave_aqui

# Opcionales (fallback adicional)
# ORCAROUTER_API_KEY=
# OPENROUTER_API_KEY1=
# OPENROUTER_API_KEY2=
# GROQ_API_KEY1=
# GROQ_API_KEY2=
# MISTRAL_API_KEY=

# ── TikTok Live ─────────────────────────────────────────────
TIKTOK_USERNAME=tu_usuario_de_tiktok

# ── Voz TTS ─────────────────────────────────────────────────
# true  = Edge TTS gratis e ilimitado (recomendado para Render)
# false = Voz clonada (Gradium/Free.ai, requiere API keys)
USE_FREE_TTS=true

# ── Oraciones estándar (idle) ───────────────────────────────
# true  = Usa audios pre-generados en oraciones_estandar/ (ahorra créditos)
# false = Genera oraciones frescas cada vez (gasta créditos de API)
USAR_ORACIONES_ESTANDAR=true

# ── Seguridad ───────────────────────────────────────────────
# Contraseña del panel de admin (cámbiala en producción)
ADMIN_PASSWORD=admin

# ── Cloudflare Turnstile (anti-spam en el chat) ─────────────
# Obtén las keys en: https://dash.cloudflare.com/turnstile
TURNSTILE_SITE_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Puerto (Render lo asigna automáticamente) ───────────────
# No cambies esto en Render — usa PORT del sistema
# PORT=3002
